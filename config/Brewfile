# Public Homebrew packages managed by setup.sh.
#
# `setup.sh` reconciles this file plus the optional generated personal
# Brewfile at ~/.config/dotfiles-managed/Brewfile.personal. This public file is
# installed before the Home Manager build so native dependencies such as
# OpenSSL are available to Rust builds; the generated personal file is installed
# after activation. Any Homebrew cask absent from both files will be removed.
# Formulae are not automatically removed because Homebrew may have installed
# them as dependencies.
#
# To inspect extra casks without removing them, run `scripts/brew-cleanup.sh`.
#
# Add a cask only if it cannot (or should not) be Nix-managed:
# - `gimp` and `vlc` are not built for aarch64-darwin in current nixpkgs
#   (`meta.platforms` excludes Darwin).
#
# Do NOT add `visual-studio-code`: it is Jamf-managed on this machine
# (com.jamf.appinstallers.MicrosoftVisualStudioCode, root-owned bundle in
# /Applications). Brew upgrades fail without sudo and Jamf re-takes
# ownership on its next push anyway. Removed 2026-06-11.

brew "ca-certificates"
brew "openssl@3"

cask "aerial"
cask "gimp"
cask "vlc"
