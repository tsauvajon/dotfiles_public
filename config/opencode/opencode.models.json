{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-luna"
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "verify": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "review": {
      "model": "openai/gpt-5.6-sol"
    },
    "scout": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "implement": {
      "model": "openai/gpt-5.6-terra"
    },
    "rust-design": {
      "model": "openai/gpt-5.6-sol"
    },
    "rust": {
      "model": "openai/gpt-5.6-terra"
    }
  }
}
