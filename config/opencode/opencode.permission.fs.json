{
  "permission": {
    "edit": {
      ".env*": "deny",
      "*": "allow"
    },
    "read": {
      ".env*": "deny",
      "*": "allow"
    },
    "external_directory": {
      "~/.cargo/*": "allow",
      "~/.config/*": "allow",
      "~/.cursor/projects/*": "allow",
      "~/.local/*": "allow",
      "~/.cache/opencode/*": "allow",
      "~/.local/cache/*": "allow",
      "~/.local/share/*": "allow",
      "~/.nix-profile/bin/*": "allow",
      "~/.profile/*": "allow",
      "~/.rustup/*": "allow",
      "~/.rustup/toolchains/*": "allow",
      "~/dev/*": "allow",
      "~/dev/dotfiles/*": "allow",
      "~/Applications/*": "allow",
      "~/Documents/Obsidian/*": "allow",
      "~/Library/Application Support/*": "allow",
      "~/Library/Logs/*": "allow",
      "~/Library/Preferences/*": "allow",
      "/Library/Desktop Pictures/*": "allow",
      "/mnt/linux/dev/*": "allow",
      "/mnt/linux/dotfiles/*": "allow",
      "/nix/store/*": "allow",
      "/private/var/*/opencode/*": "allow",
      "/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/*": "allow",
      "/System/Library/Desktop Pictures/*": "allow",
      "/var/folders/*/*/T/*": "allow",
      "/var/folders/*": "allow",
      "/tmp/*": "allow"
    }
  }
}
